# Copy this file to `.env` and fill in your own values, OR set these as real
# environment variables. This TEMPLATE is public; your filled-in `.env` is private.
#
# The bot reads most of these directly from the environment. On Windows/PowerShell
# use  $env:NAME = "value"  ; on Linux/Mac use  export NAME=value  (or a tool like
# python-dotenv / direnv). The run scripts in ./scripts set the encoding vars for you.

# ---- Telegram (required) ----
# Token from @BotFather (looks like 123456789:AA...). You can instead drop it in
# state/telegram_token.txt.
AGBOT_TELEGRAM_TOKEN=
# Your numeric chat id (message the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read chat.id). You can instead
# drop it in state/telegram_chat_id.txt.
AGBOT_OWNER_CHAT_ID=

# ---- Garmin Connect ----
# Authenticate interactively through Garmin/garminconnect first. The bridge reuses
# cached OAuth credentials; it does not drive an unattended password/MFA login.
# Where Garmin OAuth tokens are cached. Defaults to ~/.garminconnect.
# GARMINTOKENS=~/.garminconnect

# ---- Model / agent backend ----
# Which backend generates replies. "copilot" (default) uses the GitHub Copilot CLI.
# See run_llm() in telegram_bridge.py to enable openai / anthropic / ollama.
AGBOT_LLM=copilot
# Only needed for the default "copilot" backend if `copilot` isn't already on PATH:
# COPILOT_EXE=copilot
# COPILOT_HOME=
# Model + reasoning effort for the "copilot" backend. Leave AGBOT_MODEL blank to use the CLI's
# default, or set any id shown by `/model` in an interactive `copilot` session. Examples:
#   AGBOT_MODEL=gemini-3.8-flash    # only if supported by your installed CLI/account
#   AGBOT_MODEL=claude-opus-4.8
# AGBOT_REASONING_EFFORT: none|minimal|low|medium|high|xhigh|max. "medium" is a good
# starting point for comparison; actual accuracy and latency depend on your workload.
# The bot explicitly uses default context. Bigger context does not replace good retrieval.
# Raise AGBOT_LLM_TIMEOUT for slow high-reasoning models.
# AGBOT_MODEL=
# Optional, ordered fallbacks, used ONLY when the CLI explicitly rejects a model
# as unavailable. Configure vision-capable models supported by your account.
# No fallback is enabled by default; authentication/timeouts do not switch models.
# AGBOT_FALLBACK_MODELS=gemini-3.7-flash
# AGBOT_REASONING_EFFORT=medium
# AGBOT_LLM_TIMEOUT=600

# ---- Optional autonomous training programme ----
# Opt in after setting goals, equipment, availability and constraints in your
# private profile. No universal exercise list or training frequency is assumed.
# AGBOT_PROGRAM_ENABLED=true
# Defaults: weekly reviews within four-week blocks. Fresh training feedback can
# trigger a review the following day; current constraints apply immediately.
# AGBOT_PROGRAM_REVIEW_DAYS=7
# AGBOT_PROGRAM_BLOCK_DAYS=28
# Total Copilot generation budget for a review, including its optional repair:
# AGBOT_PROGRAM_REVIEW_TIMEOUT=180

# ---- Optional personalization ----
# Recommended: a PRIVATE directory outside the source checkout. Contains .env, profile.md,
# state/, logs/, backups/ and versioned releases/. Never put real data in public fixtures.
# AGBOT_DATA_DIR=
# AGBOT_PROFILE=  # optional override of <AGBOT_DATA_DIR>/profile.md
# AGBOT_PYTHON=   # optional interpreter path used by launch scripts
# AGBOT_SNAPSHOT_TTL=120
# Your first name, used only so the coach can greet you. All real personalization
# lives in profile.md.
AGBOT_USER_NAME=

# Nutrition targets are opt-in: unspecified (default), maintain or fat_loss.
AGBOT_NUTRITION_GOAL=unspecified

# Leave missing strength units unknown unless this account's endpoint was verified.
# See docs/metrics.md before setting g, kg or lb.
AGBOT_STRENGTH_WEIGHT_UNIT=
AGBOT_STRENGTH_WEIGHT_UNIT_PROVENANCE=
# Optional purpose overrides; see docs/metrics.md for the JSON shape.
# AGBOT_ACTIVITY_LABELS=
